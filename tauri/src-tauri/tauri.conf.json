{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "hmmagainagain",
	"version": "0.0.1",
	"identifier": "dev.hmmagainagain.app",
	"build": {
		"frontendDist": "../dist",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "hmmagainagain",
				"width": 900,
				"height": 700
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
