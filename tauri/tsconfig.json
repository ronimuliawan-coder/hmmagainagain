{
	// Decouples the shell frontend build from the Hutch devkit: vite
	// resolves the nearest tsconfig upward, and the repo-root one extends
	// ./.hutch/devkit (generated by `hutch electrobun prepare`), which the
	// Tauri CI jobs never create. Without this file every tauri build
	// outside a Hutch checkout fails resolving the extends.
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"strict": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": []
	},
	"include": ["harness", "vite.config.ts"]
}
