{
	"name": "hmmagainagain",
	"version": "0.0.1",
	"type": "module",
	"description": "Lightweight cross-platform desktop git client with diffshub-grade diff/tree UX",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun test",
		"check": "bun run typecheck && bun run lint && bun run test",
		"install:deps": "bun install",
		"dev": "electrobun dev",
		"build": "electrobun build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "latest",
		"@types/jsdom": "^30.0.0",
		"concurrently": "^9.1.0",
		"jsdom": "^30.0.1",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"electrobun": "2.0.1"
	},
	"dependencies": {
		"@pierre/diffs": "1.3.6",
		"@pierre/theming": "1.0.1",
		"@pierre/trees": "1.0.0-beta.6"
	}
}
